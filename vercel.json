{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(css|js|images|favicon.ico)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/(favicon-.*\\.png|logo\\.png|gambarLogin\\.png|apple-touch-icon\\.png|android-chrome-.*\\.png)$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "WOLA MUSASHI",
    "APP_ENV": "production",
    "APP_KEY": "base64:y0KHUchsJH1tYr3yhXzNIi+SQvBk5/qMP4rqb18vrNw=",
    "APP_DEBUG": "true",
    "APP_TIMEZONE": "Asia/Jakarta",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr",
    "GOOGLE_SHEET_URL": "https://docs.google.com/spreadsheets/d/15fKc1XUf5-647t-a5LC2j53FsGWE4JDl012ZVoZYgr0/edit?usp=sharing",
    "GOOGLE_APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbyaWhCf4S4xmm5yP7mPBwlxbWCEiSsv8UtzFSfFyDjPWFfnzbgXgTDlzWeSbjDq8eCr/exec"
  }
}
