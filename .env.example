APP_NAME="PT Musashi - WOLA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================
# DATABASE CONFIGURATION OPTIONS
# ==========================================================
# OPSI A: SQLite (Default Lokal Cepat & Zero-Config)
DB_CONNECTION=sqlite

# OPSI B: Local MySQL (XAMPP / Laragon)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=musashi_wola
# DB_USERNAME=root
# DB_PASSWORD=

# OPSI C: Cloud Free MySQL (TiDB Serverless untuk Vercel)
# DB_CONNECTION=mysql
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=musashi_wola
# DB_USERNAME=xxxxxx.root
# DB_PASSWORD=xxxxxx
# MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@musashi.co.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/15fKc1XUf5-647t-a5LC2j53FsGWE4JDl012ZVoZYgr0/edit?usp=sharing"
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbyaWhCf4S4xmm5yP7mPBwlxbWCEiSsv8UtzFSfFyDjPWFfnzbgXgTDlzWeSbjDq8eCr/exec"
